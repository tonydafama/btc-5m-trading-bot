# 先有波幅，先買中間價 · Mid-band Range80 LIVE
# Armed only after an explicit Go Live in finance chat.
# This file is the only env the live daemon reads for flags.
# It does not replace the shared droplet .env and must not arm any other strategy.

# Profile A · armed only after deposit confirmed in finance chat (then flip flags + start live unit).
DRY_RUN=1
REAL_MONEY=0
TRADING_MODE=paper
MIDBAND_RANGE80_LIVE=0
MIDBAND_LIVE_ARMED=0
MIDBAND_REAL_MONEY=0
MIDBAND_UNIT_USD=3
MIDBAND_RANGE_MIN_USD=100
MIDBAND_T_MIN=70
MIDBAND_T_MAX=75
MIDBAND_ASK_MIN=0.80
MIDBAND_ASK_MAX=0.85
MIDBAND_ASK_SKIP_ABOVE=0.94
LIVE_EXECUTION_MODE=fok_only
# Keep V2 unarmed even if some shared helper reads this process env.
DUAL_LEG_LIVE_DRY_RUN=1
