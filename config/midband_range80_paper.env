# 先有波幅，先買中間價 · Mid-band Range80
# PAPER / prep only. Do not set DRY_RUN=0 or REAL_MONEY=1 here.
# This file is the only env the paper daemon reads. It does not replace
# the shared droplet .env and must not arm any other strategy.

DRY_RUN=1
REAL_MONEY=0
TRADING_MODE=paper
DUAL_LEG_LIVE_DRY_RUN=1
MIDBAND_RANGE80_PAPER=1
MIDBAND_REAL_MONEY=0
MIDBAND_UNIT_USD=3
MIDBAND_RANGE_MIN_USD=100
MIDBAND_T_MIN=45
MIDBAND_T_MAX=70
MIDBAND_ASK_MIN=0.80
MIDBAND_ASK_MAX=0.85
MIDBAND_ASK_SKIP_ABOVE=0.94

