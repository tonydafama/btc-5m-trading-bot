# Copy to .env and fill in real values. NEVER commit .env to GitHub.

PHASE=2
TRADING_MODE=paper
ETH_TRADING_MODE=paper

# Polymarket CLOB (live only)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SIGNATURE_TYPE=3

# Dashboard
DASHBOARD_PORT=8083
DASHBOARD_PUBLIC_PORT=8082

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Entry / filters (defaults OK for paper)
ENTRY_T_MAX=75
ENTRY_T_MIN=22
MIN_BTC_MOVE_USD=12
ETH_MIN_MOVE_USD=1.0
