# Bot #2 — Alpha-Max live (separate MetaMask / Polymarket account)
# Copy to .env.bot2 and fill in credentials. NEVER commit .env.bot2.

BOT_INSTANCE=bot2
TRADING_MODE=live
STRATEGY=ALPHA_MAX

# MetaMask EOA private key (0x... hex, no quotes)
POLYMARKET_PRIVATE_KEY=

# Polymarket proxy / funder address (shown after connecting wallet on Polymarket)
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_DEPOSIT_ADDRESS=

# Leave blank on first run — setup_bot2_credentials.py will derive these
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# MetaMask EOA on Polymarket proxy: usually 0 (EOA) or 2 (browser proxy). Try 0 first for new MetaMask.
POLYMARKET_SIGNATURE_TYPE=0

# Risk
ALPHA_MAX_DAILY_LOSS_LIMIT=250
OBSERVER_POLL_SEC=5
LIVE_EXECUTION_MODE=fok_only
LIVE_FILL_TO_MAX_ASK=1

# Dashboard (optional second instance later)
DASHBOARD_PORT=8085
DASHBOARD_PUBLIC_PORT=8081
